# --- LLM Provider: choose "openai" or "gemini" ---
LLM_PROVIDER=openai

OPENAI_API_KEY=sk-your-openai-key-here
OPENAI_MODEL=gpt-4o-mini

GEMINI_API_KEY=your-gemini-key-here
GEMINI_MODEL=gemini-1.5-flash

# --- Web research (Company Research Agent) ---
# Get a free key at https://tavily.com - without it, research falls back to
# low-confidence LLM-only reasoning instead of live web data.
TAVILY_API_KEY=tvly-your-key-here

# --- App ---
APP_ENV=development
CORS_ORIGINS=http://localhost:3000,https://your-frontend.vercel.app
REQUEST_TIMEOUT_SECONDS=30

# --- Caching / Rate limiting / Retry ---
CACHE_TTL_SECONDS=3600
RATE_LIMIT_PER_MINUTE=20
MAX_RETRIES=3
RETRY_BACKOFF_SECONDS=1.5
